# Web Push (VAPID) configuration
# Generate a key pair with: npx web-push generate-vapid-keys
# The PUBLIC key can be exposed to the client; the PRIVATE key must stay secret.

# Public key (safe to expose in client-side code)
VAPID_PUBLIC_KEY=your_public_key_here

# Private key (KEEP SECRET — never commit the real value)
VAPID_PRIVATE_KEY=your_private_key_here

# Contact email used in the VAPID "subject" claim (mailto: or https: URL)
VAPID_SUBJECT=mailto:you@example.com
