# Supabase — copy to .env.local and fill in with your project's values.
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never ship to the client.
# Used for privileged actions such as LGPD account deletion (auth.admin.deleteUser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the app (used for OAuth/password-recovery redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
